DATABASE_URL=postgresql+psycopg://finza:CHANGE_ME@localhost:5432/finza
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Development only: comma-separated browser origins for the Expo web preview (leave empty otherwise)
FINZA_CORS_ORIGINS=
# Sign in with Google / Apple (comma-separated audiences from Google Cloud / Apple Developer; empty = disabled)
FINZA_GOOGLE_CLIENT_IDS=
FINZA_APPLE_AUDIENCES=
# Password recovery e-mail: smtp | log (development only, writes the link to the API log) | empty = disabled
FINZA_MAIL_MODE=
FINZA_MAIL_FROM=
FINZA_SMTP_HOST=
FINZA_SMTP_PORT=587
FINZA_SMTP_USER=
FINZA_SMTP_PASSWORD=
FINZA_RESET_LINK_BASE=finza://reset-password
# Link e-mailed to confirm the address (opens /verify-email in the app)
FINZA_VERIFY_LINK_BASE=finza://verify-email
