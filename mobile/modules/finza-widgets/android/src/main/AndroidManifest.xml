      android:name="co.edu.unisabana.finza.widgets.SummaryWidgetProvider"
      android:exported="false"
      android:label="@string/finza_widget_summary_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/finza_widget_summary_info" />
    </receiver>
    <receiver
