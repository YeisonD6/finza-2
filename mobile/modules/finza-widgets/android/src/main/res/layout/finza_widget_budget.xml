<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/finza_budget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/finza_widget_bg_surface"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:id="@+id/finza_budget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="sans-serif-medium"
    android:maxLines="1"
    android:text="Presupuesto"
    android:textColor="@color/finza_widget_ink_muted"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/finza_budget_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Tu presupuesto"
    android:textColor="@color/finza_widget_ink"
    android:textSize="16sp"
    android:textStyle="bold" />

  <ProgressBar
    android:id="@+id/finza_budget_bar_ok"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="8dp"
    android:layout_marginTop="10dp"
    android:importantForAccessibility="no"
    android:indeterminate="false"
    android:max="100"
    android:progress="60"
    android:progressDrawable="@drawable/finza_widget_progress_ok"
    android:visibility="visible" />

  <ProgressBar
    android:id="@+id/finza_budget_bar_warning"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="8dp"
    android:layout_marginTop="10dp"
    android:importantForAccessibility="no"
    android:indeterminate="false"
    android:max="100"
    android:progress="60"
    android:progressDrawable="@drawable/finza_widget_progress_warning"
    android:visibility="gone" />

  <ProgressBar
    android:id="@+id/finza_budget_bar_exceeded"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="8dp"
    android:layout_marginTop="10dp"
    android:importantForAccessibility="no"
    android:indeterminate="false"
    android:max="100"
    android:progress="60"
    android:progressDrawable="@drawable/finza_widget_progress_exceeded"
    android:visibility="gone" />

  <TextView
    android:id="@+id/finza_budget_percent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:fontFamily="sans-serif-medium"
    android:fontFeatureSettings="tnum"
    android:maxLines="1"
    android:text="60 % usado"
    android:textColor="@color/finza_widget_accent"
    android:textSize="14sp" />

  <TextView
    android:id="@+id/finza_budget_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:fontFeatureSettings="tnum"
    android:maxLines="2"
    android:text="Toca para ver tus presupuestos."
    android:textColor="@color/finza_widget_ink_muted"
    android:textSize="13sp" />

  <TextView
    android:id="@+id/finza_budget_more"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:maxLines="2"
    android:textColor="@color/finza_widget_ink_muted"
    android:textSize="12sp"
    android:visibility="gone" />
</LinearLayout>
