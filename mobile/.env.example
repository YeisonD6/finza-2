# API base URL. Android emulator without adb reverse: http://10.0.2.2:8000
# Phone with Expo Go: leave empty or set to auto to use the Metro computer's IP
# (port EXPO_PUBLIC_API_PORT, default 8000), which follows Wi-Fi changes.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Google Sign-In (public OAuth client IDs from Google Cloud; empty = button hidden)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc (iOS builds only)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
